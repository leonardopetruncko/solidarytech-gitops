    {
      "id": 3,
      "type": "stat",
      "title": "Disponibilidade (30d)",
      "description": "SLI medido na janela do SLO. Verde = dentro do SLO de 99,5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:donation_availability:ratio_rate30d",
          "legendFormat": "",
          "instant": true,
          "range": false
