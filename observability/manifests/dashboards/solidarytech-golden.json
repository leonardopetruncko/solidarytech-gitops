          },
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"solidarytech\", container!=\"\", container!=\"POD\"}) / 1048576",
          "legendFormat": "uso {{container}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (kube_pod_container_resource_requests{namespace=\"solidarytech\", resource=\"memory\"}) / 1048576",
          "legendFormat": "request {{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
